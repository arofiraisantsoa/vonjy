# Copier en .env puis lancer : node --env-file=.env src/server.js

PORT=3000
DB_PATH=./data/vonjy.db

# Jeton du tableau de bord (au moins 16 caractères). Générer : openssl rand -hex 24
ADMIN_TOKEN=

# Passerelle SMS : application « SMS Gateway for Android » (https://sms-gate.app)
# Mode local (téléphone sur le même réseau) : http://IP_DU_TELEPHONE:8080
# Mode cloud : https://api.sms-gate.app
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=
# Clé de signature des webhooks (application : Settings > Webhooks > Signing Key)
WEBHOOK_SIGNING_KEY=

# true = SMS seulement journalisés (aucun envoi réel). Vrai par défaut sans passerelle.
SMS_DRY_RUN=
# true = autorise /api/simulate/sms pour tester sans téléphone
SIMULATION=false

# Délai avant escalade si personne ne répond OK (secondes)
ACK_TIMEOUT_SECONDS=180
# Délai pendant lequel un habitant peut annuler une fausse alerte (secondes)
CANCEL_WINDOW_SECONDS=120
# Numéro du téléphone passerelle, affiché sur le tableau de bord
SERVICE_NUMBER=
